{:paths ["src" "resources" "test"]

 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/core.async {:mvn/version "1.6.681"}
        org.clojure/data.json {:mvn/version "2.4.0"}
        overtone/osc-clj {:mvn/version "0.9.0"}
        metosin/jsonista {:mvn/version "0.3.8"}
        org.clojure/tools.nrepl {:mvn/version "0.2.13"}}

 :aliases {:repl {:extra-paths ["dev"]
                  :extra-deps {nrepl/nrepl {:mvn/version "1.0.0"}
                               cider/cider-nrepl {:mvn/version "0.45.0"}
                               clj-commons/pomegranate {:mvn/version "1.2.23"}}
                  :main-opts ["-m" "nrepl.cmdline"
                              "--middleware" "[cider.nrepl/cider-middleware]"]}

           :overtone {:main-opts ["-m" "music-topos.repl"]}

           :sonification {:extra-deps {org.clojure/tools.nrepl {:mvn/version "0.2.13"}}
                          :jvm-opts ["-Xmx2g" "-Djava.awt.headless=false"]}

           :test {:extra-paths ["test"]
                  :extra-deps {midje/midje {:mvn/version "1.10.5"}}
                  :main-opts ["-m" "midje.repl"]}

           :build {:deps {io.github.clojure/tools.build
                           {:git/tag "v0.9.4" :git/sha "76b78fe"}}
                   :paths ["src" "resources"]
                   :ns-default build}}

 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://clojars.org/repo/"}}}
