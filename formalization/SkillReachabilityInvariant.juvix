module SkillReachabilityInvariant;

import Stdlib.Prelude open;

-- Constraint cloning for Anoma/Juvix:
--   1) skill count is non-decreasing unless explicit human oversight exists
--   2) reachability cost steadily decreases (strict on growth, non-increasing otherwise)

type Oversight :=
  | NoOversight
  | HumanOversight String;

open Oversight using {NoOversight; HumanOversight};

type SkillSnapshot :=
  mk@{
    skillCount : Nat;
    reachabilityCost : Nat;
    oversight : Oversight;
  };

isHumanOversight : Oversight -> Bool
  | NoOversight := false
  | (HumanOversight _) := true;

nonDecreasingSkillCountUnlessOversight (prev next : SkillSnapshot) : Bool :=
  case next of
    SkillSnapshot.mk@{skillCount := nc; oversight := ov} :=
      case prev of
        SkillSnapshot.mk@{skillCount := pc} :=
          if
            | isHumanOversight ov := true
            | else := nc >= pc;

steadilyDecreasingReachabilityCostUnlessOversight (prev next : SkillSnapshot) : Bool :=
  case next of
    SkillSnapshot.mk@{skillCount := nc; reachabilityCost := ncost; oversight := ov} :=
      case prev of
        SkillSnapshot.mk@{skillCount := pc; reachabilityCost := pcost} :=
          if
            | isHumanOversight ov := true
            | nc > pc := ncost < pcost
            | else := ncost <= pcost;

validTransition (prev next : SkillSnapshot) : Bool :=
  nonDecreasingSkillCountUnlessOversight prev next
    && steadilyDecreasingReachabilityCostUnlessOversight prev next;

-- Anoma intent-shaped payload for this policy.
type ReachabilityInvariantIntent :=
  mk@{
    previous : SkillSnapshot;
    next : SkillSnapshot;
    witness : String;
  };

satisfiesInvariantIntent (intent : ReachabilityInvariantIntent) : Bool :=
  case intent of
    ReachabilityInvariantIntent.mk@{previous := p; next := n} :=
      validTransition p n;

-- Geb-facing boolean conjunction shape for downstream compilation.
asConstraintPair (prev next : SkillSnapshot) : Pair Bool Bool :=
  nonDecreasingSkillCountUnlessOversight prev next
    , steadilyDecreasingReachabilityCostUnlessOversight prev next;

-- Locally dense time (bounded local time-gap between accepted snapshots).
type TimedSkillSnapshot :=
  mk@{
    tick : Nat;
    snap : SkillSnapshot;
  };

locallyDenseTimeUnlessOversight
  (maxGap : Nat) (prev next : TimedSkillSnapshot) : Bool :=
  case next of
    TimedSkillSnapshot.mk@{tick := nt; snap := ns} :=
      case prev of
        TimedSkillSnapshot.mk@{tick := pt} :=
          case ns of
            SkillSnapshot.mk@{oversight := ov} :=
              if
                | isHumanOversight ov := true
                | else := nt >= pt && sub nt pt <= maxGap;

validTimedTransition
  (maxGap : Nat) (prev next : TimedSkillSnapshot) : Bool :=
  case prev of
    TimedSkillSnapshot.mk@{snap := ps} :=
      case next of
        TimedSkillSnapshot.mk@{snap := ns} :=
          validTransition ps ns
            && locallyDenseTimeUnlessOversight maxGap prev next;
