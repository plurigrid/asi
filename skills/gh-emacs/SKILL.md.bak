  ["Remote Eval"
   ("e e" "Eval expression" gh-emacs-remote-eval)
   ("e b" "Eval buffer" gh-emacs-remote-eval-buffer)
   ("e r" "Eval region" gh-emacs-remote-eval-region)]
  ["Jobs"
