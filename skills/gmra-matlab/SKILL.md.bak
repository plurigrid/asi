% Load data
X = randn(1000, 50);  % 1000 points in 50D

% Build GMRA tree
opts = struct();
opts.MaxLevels = 4;
opts.IntrinsicDim = 8;
gmra = GMRA(X, opts);

% Query at level
[approx, cell_idx] = gmra.project(query, level);
